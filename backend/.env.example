APP_ENV=development
POSTGRES_DB=__pg__db
POSTGRES_USER=__pg__user
POSTGRES_PASSWORD=__pg__pwd
POSTGRES_PORT=__pg__port__5432
DATABASE_URL=postgresql+asyncpg://__pg__user:__pg__pwd@127.0.0.1:__pg__port__5432/__pg__db
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
OTP_HMAC_SECRET=change-me-otp-hmac-secret-at-least-32-bytes
ADMIN_API_KEY=__some__key
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
JWT_ACCESS_TOKEN_TTL_MINUTES=60
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
ENABLE_DEMO_OTP=false
# Kafka connection — kafka:9092 is reachable from processes on the Compose network;
# use a host-reachable bootstrap only via the temporary 127.0.0.1:29092 debug listener.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_COMMAND_TOPIC=wallet
KAFKA_DLQ_TOPIC=wallet_dlq
KAFKA_WORKER_GROUP_ID=wallet_worker
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=10000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=30000
KAFKA_PRODUCER_MAX_RETRIES=5
KAFKA_PRODUCER_RETRY_BACKOFF_MS=200
KAFKA_PRODUCER_RETRY_BACKOFF_MAX_MS=2000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_MS=500
WORKER_RETRY_BACKOFF_MAX_MS=5000
WORKER_POLL_TIMEOUT_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=3000
WORKER_SESSION_TIMEOUT_MS=30000
WORKER_MAX_POLL_INTERVAL_MS=300000
REAPER_INTERVAL_SECONDS=30
REAPER_STALE_THRESHOLD_SECONDS=60
REAPER_BATCH_SIZE=100
ADMIN_LONG_POLL_DEFAULT_SECONDS=25
ADMIN_LONG_POLL_MAX_SECONDS=30
SSE_HEARTBEAT_INTERVAL_SECONDS=15
SSE_RETRY_MILLISECONDS=3000